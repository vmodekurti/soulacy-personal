aws_region       = "us-east-1"
name             = "soulacy"
environment      = "production"
# deploy.sh --mode is authoritative; this is the safe default for direct
# Terraform use.
deployment_mode  = "personal"
infrastructure_profile = "standard"
domain_name      = "soulacy.example.com"
# Standard deployments use the AWS edge below. Team Lite's guided quickstart
# writes ingress_mode="cloudflare_tunnel" and leaves route53_zone_id empty.
ingress_mode      = "alb"
route53_zone_id  = "Z0123456789EXAMPLE"

# Strongly recommended for normal user login. The secret itself is supplied to
# deploy.sh through SOULACY_AWS_OIDC_CLIENT_SECRET, never Terraform state.
oidc_issuer    = "https://your-tenant.us.auth0.com/"
oidc_client_id = "replace-me"

# deploy.sh computes and passes all image and secret-name variables.

gateway_instance_type = "m7i.large"
worker_instance_type  = "m7i.xlarge"
nats_instance_type    = "t3.small"
db_instance_class     = "db.t4g.medium"
redis_node_type       = "cache.t4g.small"
worker_concurrency    = 4

enable_deletion_protection = true

# Used by --mode team-lite. The deployment script overrides the infrastructure
# profile to budget and creates an account-wide AWS Budget. Set the alert email
# with SOULACY_AWS_BUDGET_EMAIL. Email addresses are operational metadata, not
# secrets, and will be recorded in Terraform state.
monthly_budget_usd = 180
enable_off_hours_schedule = true
off_hours_timezone        = "America/Chicago"
off_hours_start_hour       = 8
off_hours_stop_hour        = 22

tags = {
  Owner      = "platform-team"
  CostCenter = "ai-platform"
}
