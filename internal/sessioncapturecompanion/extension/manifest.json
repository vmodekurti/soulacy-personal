{
  "manifest_version": 3,
  "name": "Soulacy Secure Session Capture",
  "version": "1.0.1",
  "description": "Captures an approved website session directly into a Soulacy workspace without exposing passwords.",
  "permissions": ["cookies", "scripting", "storage", "tabs"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Connect Session Capture to Soulacy", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://*.soulacy.io/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["content-script.js"],
    "run_at": "document_start"
  }]
}
